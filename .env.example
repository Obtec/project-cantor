# ---- 데이터베이스 (MySQL) ----
DB_NAME=cantor
DB_USER=cantor
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password

# ---- 인증 (JWT) ----
# 반드시 32바이트 이상의 무작위 문자열로 변경하세요.
JWT_SECRET=change-me-in-production-this-needs-to-be-at-least-32-bytes-long
JWT_EXPIRATION=86400000

# ---- CORS ----
# 동일 출처(proxy 경유)면 비워둬도 되지만, 개발 서버(5173)를 함께 허용한다.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ---- 시드 편집자 계정 (최초 기동 시 1회 생성) ----
SEED_EDITOR_EMAIL=editor@cantor.org
SEED_EDITOR_PASSWORD=change-this-editor-password

# ---- 심사 정책 ----
# 이중맹검: 리뷰어에게 저자 정보를 숨김(게재 전). 기본 true.
REVIEW_DOUBLE_BLIND=true

# ---- 이메일 알림(선택) ----
# 인앱 알림은 항상 동작. 이메일까지 보내려면 true + 표준 spring.mail.* 설정 필요.
MAIL_ENABLED=false
MAIL_FROM=no-reply@cantor.org

# ---- 배포 (HTTPS / certbot) ----
# 실제 도메인이 있을 때만 채우세요. 로컬은 비워두면 됩니다.
DOMAIN=
LETSENCRYPT_EMAIL=
# 발급 테스트 시 1로 두면 Let's Encrypt 스테이징 인증서를 받습니다.
STAGING=0
